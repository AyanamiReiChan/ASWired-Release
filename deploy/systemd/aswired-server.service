[Unit]
Description=ASWired controller
Wants=network-online.target aswired-certificates.path aswired-upgrade-backups.path
After=network-online.target
[Service]
Type=simple
User=aswired
Group=aswired
WorkingDirectory=/var/lib/aswired
EnvironmentFile=/etc/aswired/server.env
ExecStart=/opt/aswired/current/bin/aswired-server serve
Restart=on-failure
RestartSec=5
TimeoutStopSec=240
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/aswired
[Install]
WantedBy=multi-user.target
